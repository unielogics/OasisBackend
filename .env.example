# Backend environment contract. Copy to .env (never commit .env). `*_PROVIDER=sim` needs nothing else for that integration.
# This file is for development. Production uses deploy/env/*.env.example (one documented template per service, written to /etc/oasis by
# deploy/scripts/install.sh) because systemd reads those files and a shell-style dotenv file differs in two ways that matter: a "#"
# after a value is part of the value, and an EMPTY value is not "unset" (the app rejects an empty BOOTSTRAP_ADMIN_EMAIL, for example,
# so delete a line you are not using instead of leaving it blank). Real integrations are proven with pnpm verify:* (docs/live-verification.md).
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_URL=postgres://oasis:CHANGE@127.0.0.1:5432/oasis_dev
DATABASE_URL_TEST=postgres://oasis:CHANGE@127.0.0.1:5432/oasis_test
DATABASE_URL_PARITY=postgres://oasis:CHANGE@127.0.0.1:5432/oasis_parity
SESSION_SECRET=              # >=32 random bytes (base64); required in production
SESSION_COOKIE_NAME=oasis_sid
SECRETS_KEY=                 # base64 32 bytes; encrypts integration credentials at rest (store a copy in a secrets manager)
COOKIE_SECURE=false          # true behind HTTPS
TRUST_PROXY=false           # behind nginx on the same host: true (one trusted hop). Never a list that includes the public internet
PUBLIC_API_URL=http://localhost:4000
PUBLIC_DASHBOARD_URL=http://localhost:3000
BUSINESS_TZ=America/New_York # initial value for the settings row only
BOOTSTRAP_ADMIN_EMAIL=       # creates the first Super Admin on an empty database
BOOTSTRAP_ADMIN_PASSWORD=
CLOCK_FREEZE_AT=             # parity/test only (e.g. 2026-06-13T10:36:00-04:00); refused in production
ALLOW_DEV_ENDPOINTS=false       # dev-only helpers (inject an inbound text, read the console mailbox); refused in production
DEV_AUTH_BYPASS=false         # local development only: every request is a signed-in user with all permissions (refused in production)
ALLOWED_ORIGINS=             # extra comma-separated browser origins allowed on unsafe methods (dashboard/API origins are implicit)
RATE_LIMIT_PER_MIN=300
SSE_HEARTBEAT_MS=20000
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
PGBOSS_SCHEMA=pgboss
JOBS_ENABLED=true
RESCHEDULE_LINK_ENABLED=false  # emergency/closure SMS drop the {link} sentence until a reschedule landing page exists

# --- Squarespace (card processor + commerce source; READ-ONLY for payments) ---
SQSP_PROVIDER=sim            # sim|live
SQSP_API_BASE=https://api.squarespace.com
SQSP_API_KEY=                # Commerce APIs key (needs Commerce Advanced); webhooks additionally need an OAuth app
SQSP_POLL_INTERVAL_SECONDS=120
SQSP_LAPSE_CANCEL_DAYS=60    # membership with no paid renewal this long after the grace period is inferred cancelled (0 = never infer)
# The API key can also be stored encrypted with PUT /api/v1/integrations/squarespace/connection (needs SECRETS_KEY).
PAYMENT_LINK_HOSTS=          # comma-separated hosts a payment link may point at (exact or subdomain). Default squarespace.com allows ANY Squarespace site, including one an outsider owns: set your store's host, e.g. shop.oasisautospa.com

# --- SMS: SMS Gate on a cellular Android tablet over Tailscale ---
SMS_PROVIDER=sim             # sim|smsgate
# The tablet itself (URL, credentials, webhook signing key) is registered with POST /api/v1/integrations/sms/devices and stored
# encrypted with SECRETS_KEY; the runtime does not read a device URL from the environment.
SMS_DISPATCH_MODE=jobs       # jobs (pg-boss worker) | inline (this API process drains the outbox) | off
SMS_TICK_INTERVAL_MS=2000
SMS_QUIET_HOURS=21:00-08:00  # holds non-transactional texts only; "off" disables
SMSGATE_WEBHOOK_PUBLIC_URL=  # https://<host>.<tailnet>.ts.net/hooks/smsgate (tailscale serve --set-path); the tablet appends /<deviceKey>
HOOKS_HOST=127.0.0.1         # second, tailnet-facing listener for /hooks/smsgate/:deviceKey (the public listener answers 404 for it)
HOOKS_PORT=3002              # 0 disables the listener
BUSINESS_PHONE=              # shown in the HELP reply
SMSGATE_MAX_PER_WINDOW=30    # Android prompts after ~30 SMS/30 min; verify on the real device before raising
SMSGATE_WINDOW_MINUTES=30
SMS_ALLOWLIST=               # comma-separated E.164; non-production sends only to these (seeds hold fake numbers)

# --- Email (AWS SES) ---
EMAIL_PROVIDER=sim           # sim|ses
AWS_REGION=us-east-1
SES_FROM_ADDRESS=
SES_FROM_NAME=Oasis Auto Spa
SES_REPLY_TO=
SES_CONFIGURATION_SET=
EMAIL_CONSOLE_DIR=./.data/mail   # the sim driver writes .eml files here

# --- Files (photos, documents) ---
# Not yet read by the app: S3_KEY_PREFIX, S3_SSE, S3_KMS_KEY_ID, S3_ENDPOINT and S3_FORCE_PATH_STYLE (documented in docs/integrations/s3.md) are
# not declared in src/config/env.ts, so loadEnv drops them. Until they are, give the app's IAM role the whole bucket (docs/deployment.md).
STORAGE_PROVIDER=fs          # fs|s3
STORAGE_FS_ROOT=./.data/files
S3_BUCKET=
