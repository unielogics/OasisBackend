{
  "name": "oasis-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Oasis Auto Spa API (Fastify + Postgres): scheduling, ledger, settings, SMS Gate and Squarespace integrations",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "tsx scripts/migrate.ts",
    "db:schema": "tsx scripts/db-schema.ts",
    "db:schema:check": "tsx scripts/db-schema.ts --check",
    "openapi": "tsx scripts/openapi.ts",
    "seed": "tsx db/seeds/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run test/unit test/platform.test.ts",
    "test:int": "vitest run test/integration",
    "bootstrap:verify": "bash scripts/bootstrap/verify.sh",
    "sim:smsgate": "tsx scripts/sim-smsgate.ts",
    "sim:squarespace": "tsx scripts/sim-squarespace.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm openapi --check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "5.1.0",
    "kysely": "^0.29.6",
    "libphonenumber-js": "^1.13.14",
    "luxon": "^3.7.2",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "pg-boss": "10.4.2",
    "pino": "^10.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
