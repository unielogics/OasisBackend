{
  "name": "oasis-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Oasis Auto Spa API (Fastify + Postgres): scheduling, ledger, settings, SMS Gate and Squarespace integrations",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "bootstrap:verify": "bash scripts/bootstrap/verify.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
