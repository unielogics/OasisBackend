# /etc/nginx/conf.d/oasis.conf  -  the public site (rendered by deploy/scripts/install.sh; edit the template, not this file).
#
#   /                     the dashboard (Next.js, 127.0.0.1:@WEB_PORT@)
#   /api/                 the API (Fastify, 127.0.0.1:@API_PORT@), same origin as the dashboard so there is no CORS
#   /api/v1/events        the Server-Sent Events stream: no buffering, one-hour reads
#   /api/v1/public/*      the website's API under the website host's rules (ADR 0150): reads cached 60 s under a fixed key, writes
#                         in the oasis_public_post zone with a 16k body limit, no cookies either way
#   /hooks/squarespace    Squarespace webhook (signed, public), 1 MB body limit, POST only
#   /hooks/ses            Amazon SNS feedback (signed, public)
#   /hooks/*              everything else, including /hooks/smsgate, answers 404 here. The SMS Gate webhook is served only on
#                         the tailnet (tailscale-serve.sh -> the API's second listener).
#   any other letter case of /api, /dev-storage or /hooks: 404 (Next.js would otherwise rewrite it to the API around these rules)
# Only @DOMAIN@ is served: a request for a bare IP address or any other name gets nothing (the two default servers below).

# Plain HTTP for any other name or none: close the connection without an answer.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    access_log /var/log/nginx/oasis.access.log oasis;
    return 444;
}

# HTTPS for any other name, or no name (a bare IP address): refuse the TLS handshake, so not even the certificate is shown.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://@DOMAIN@$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @DOMAIN@;

    ssl_certificate @TLS_CERT@;
    ssl_certificate_key @TLS_KEY@;
    # protocols, ciphers and the shared session cache: the same file for every HTTPS server of this host
    include @NGINX_DIR@/oasis/tls.conf;

    access_log /var/log/nginx/oasis.access.log oasis;
    error_log /var/log/nginx/oasis.error.log warn;

    # The API's own body limit is 1 MB (photos go straight to S3 with a presigned POST); nginx stops anything larger earlier.
    client_max_body_size 2m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 65s;
    limit_conn oasis_conn 200;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # Every answer of this site carries HSTS and nosniff, nginx's own included (403, 404, 413, 429, 502 ...). proxy.conf hides the
    # upstream copies so each header arrives once. A location with add_header of its own (the dashboard: security-headers.conf)
    # does not inherit these, so that file repeats them.
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    # --- probes ---
    # Liveness is public (an uptime monitor can use it). Readiness reports database and migration detail: this host only.
    location = /healthz {
        include @NGINX_DIR@/oasis/proxy.conf;
        access_log off;
        proxy_pass http://oasis_api;
    }

    location = /readyz {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        include @NGINX_DIR@/oasis/proxy.conf;
        access_log off;
        proxy_pass http://oasis_api;
    }

    # --- webhooks ---
    location = /hooks/squarespace {
        limit_except POST {
            deny all;
        }
        limit_req zone=oasis_hooks burst=40 nodelay;
        client_max_body_size 1m;
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_pass http://oasis_api;
    }

    location = /hooks/ses {
        limit_except POST {
            deny all;
        }
        limit_req zone=oasis_hooks burst=40 nodelay;
        client_max_body_size 1m;
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_pass http://oasis_api;
    }

    # Everything else under /hooks, notably /hooks/smsgate, is not public.
    location ^~ /hooks/ {
        default_type application/json;
        return 404 '{"ok":false,"status":"not_found"}';
    }

    # The filesystem-storage simulator is for development only. Production stores photos in S3.
    location ^~ /dev-storage/ {
        default_type application/json;
        return 404 '{"ok":false,"status":"not_found"}';
    }

    # --- API ---
    # The OpenAPI document describes every route; it is not for the public.
    location = /api/v1/openapi.json {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_pass http://oasis_api;
    }

    # Server-Sent Events: nothing may buffer or compress the stream, and the connection lives for hours.
    location = /api/v1/events {
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://oasis_api;
    }

    # --- the public website's API (ADR 0150): the very rules of the website's host (oasis-site.conf), so this host is no way around
    # them (review 2026-10-10): the three reads cached 60 s under a fixed key, GET only; the writes (codes, bookings, joins) under the
    # stricter oasis_public_post zone with the website's 16k body limit; no cookie either way (a website call is never a session).
    location = /api/v1/public/hours {
        limit_except GET { deny all; }
        limit_req zone=oasis_api burst=20 nodelay;
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie;
        proxy_cache oasis_public;
        proxy_cache_key "$scheme$host$uri";
        proxy_cache_valid 200 60s;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://oasis_api;
    }

    location = /api/v1/public/availability {
        limit_except GET { deny all; }
        limit_req zone=oasis_api burst=20 nodelay;
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie;
        proxy_cache oasis_public;
        proxy_cache_key "$scheme$host$uri?days=$arg_days&service=$arg_service";
        proxy_cache_valid 200 60s;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://oasis_api;
    }

    location = /api/v1/public/catalog {
        limit_except GET { deny all; }
        limit_req zone=oasis_api burst=20 nodelay;
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie;
        proxy_cache oasis_public;
        proxy_cache_key "$scheme$host$uri";
        proxy_cache_valid 200 60s;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://oasis_api;
    }

    location ^~ /api/v1/public/ {
        limit_req zone=oasis_public_post burst=10 nodelay;
        client_max_body_size 16k;
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie;
        add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_pass http://oasis_api;
    }

    # ^~: a request under /api/ never falls through to the regular expressions below.
    location ^~ /api/ {
        limit_req zone=oasis_api burst=60 nodelay;
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_pass http://oasis_api;

        # Sign-in, password reset and invitation endpoints get the tighter zone.
        location ~ ^/api/v1/auth/(login|password/forgot|password/reset|invite/accept)$ {
            limit_req zone=oasis_login burst=10 nodelay;
            include @NGINX_DIR@/oasis/proxy.conf;
            proxy_pass http://oasis_api;
        }
    }

    # nginx prefixes are case-sensitive, but the dashboard's rewrites (/api/*, /dev-storage/* to the API) are not: /API/v1/... would
    # reach the API through Next.js, around the deny rules and the rate limits above. Any other letter case (and the bare names)
    # ends here.
    location ~* ^/(api|dev-storage|hooks)(/|$) {
        default_type application/json;
        return 404 '{"ok":false,"status":"not_found"}';
    }

    # --- dashboard ---
    location / {
        include @NGINX_DIR@/oasis/security-headers.conf;
        include @NGINX_DIR@/oasis/proxy.conf;
        proxy_pass http://oasis_web;
    }
}
