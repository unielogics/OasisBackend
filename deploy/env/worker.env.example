# /etc/oasis/worker.env  -  oasis-worker only (mode 0640, owner root:oasis). Read after common.env, so a line here wins.
# The worker runs the pg-boss jobs: SMS dispatch, reminders, Squarespace sync, membership cycle, email, retention.
# It listens on no port. It needs the same SECRETS_KEY and SESSION_SECRET as the API, which is why those live in common.env.
# Same file rules as common.env: comments on their own line, single quotes around values with spaces or braces.

# Heap cap for the worker process (MB).
NODE_OPTIONS=--max-old-space-size=512

# The worker's connection pool. Jobs are short; 6 is plenty next to the API's 10 on a small Postgres.
DB_POOL_MAX=6
