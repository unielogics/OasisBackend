# /etc/oasis/web.env  -  oasis-web only: the dashboard (Next.js production server). Mode 0640, owner root:oasis.
# The dashboard calls /api on its own origin; nginx sends /api to the API, so nothing here points at the API.
# Same file rules as common.env: comments on their own line.

# Loopback only; nginx proxies to it.
WEB_HOST=127.0.0.1
WEB_PORT=3200

# Heap cap for the Next server (MB).
NODE_OPTIONS=--max-old-space-size=768

# Do not send anonymous usage data to Vercel.
NEXT_TELEMETRY_DISABLED=1
