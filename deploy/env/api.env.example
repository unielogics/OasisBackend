# /etc/oasis/api.env  -  oasis-api only (mode 0640, owner root:oasis). Read after common.env, so a line here wins.
# Same file rules as common.env: comments on their own line, single quotes around values with spaces or braces.

# The API listens on loopback only; nginx is the only way in. Do not bind it to 0.0.0.0.
HOST=127.0.0.1
PORT=4000

# Trust the X-Forwarded-For header that nginx sets. nginx overwrites it with the real client address (it never appends to
# what a client sent), and the API is unreachable except through nginx, so this is safe. false would log every request as 127.0.0.1.
TRUST_PROXY=true

# Secure session cookies (named __Host-oasis_sid) and the Strict-Transport-Security header. Requires HTTPS.
COOKIE_SECURE=true

# The second, tailnet-facing listener for the SMS Gate webhook. tailscale-serve.sh points the tailnet mount at it. The public
# listener answers 404 for /hooks/smsgate. 0 turns the listener off (inbound texts and delivery receipts stop).
HOOKS_HOST=127.0.0.1
HOOKS_PORT=3002

# Extra browser origins allowed on unsafe requests, comma separated. The dashboard origin is implicit. Normally empty.
ALLOWED_ORIGINS=

# Requests per minute per signed-in user (per address when anonymous). 429 beyond it.
RATE_LIMIT_PER_MIN=300

# Milliseconds between keep-alive comments on the event stream. Keep below nginx's proxy_read_timeout.
SSE_HEARTBEAT_MS=20000

# First Super Admin, created on an empty database at boot. Use deploy/scripts/bootstrap-admin.sh set you@example.com, which adds
# both lines with a generated password; after you have signed in run bootstrap-admin.sh clear, which removes them. An empty value
# is not accepted by the app, so these stay commented out until then. Password: at least 12 characters.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
