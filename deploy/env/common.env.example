# /etc/oasis/common.env  -  settings shared by oasis-api and oasis-worker (mode 0640, owner root:oasis).
#
# Rules for every env file in this directory (systemd reads them, not a shell):
#   - one NAME=value per line, no spaces around "=", no "export";
#   - comments only on their own line (a "#" after a value becomes part of the value);
#   - a value with spaces, quotes or braces goes in single quotes: SQSP_PRODUCT_MAP='[{"sku":"MEM-PREMIUM"}]';
#   - a commented-out NAME= line is an optional setting that is off; remove the "#" to use it.
# install.sh creates this file from this template, fills the secrets and the URLs, and never overwrites an existing file.
# Every variable of src/config/env.ts is listed here or in api.env / worker.env / web.env.

# --- Runtime ---------------------------------------------------------------------------------------------------------------

# production switches on the safety checks: SESSION_SECRET is required, CLOCK_FREEZE_AT and DEV_AUTH_BYPASS are refused.
NODE_ENV=production

# fatal, error, warn, info, debug or trace. info is right for production.
LOG_LEVEL=info

# Cap for the Node heap per process (MB); the host is small and shared with Postgres.
NODE_OPTIONS=--max-old-space-size=768

# Business time zone, used for the initial settings row only (hours, closures and reminders follow Settings afterwards).
BUSINESS_TZ=America/New_York

# Phone number shown in the HELP reply to a customer text. Example: (305) 555-0100
BUSINESS_PHONE=

# --- Database --------------------------------------------------------------------------------------------------------------

# Postgres 15. install.sh creates the role and database and writes this line. Percent-encode special characters in the password.
DATABASE_URL=postgres://oasis:CHANGE_ME@127.0.0.1:5432/oasis

# Connections the process may open (API and worker each have their own pool; see api.env and worker.env for overrides).
DB_POOL_MAX=10

# Statement timeout in milliseconds, 0 disables. 30 seconds protects the pool from a runaway query.
DB_STATEMENT_TIMEOUT_MS=30000

# Schema holding the pg-boss job tables. Leave as is after the first start.
PGBOSS_SCHEMA=pgboss

# Test schemas only (t_xxx,public). Leave unset in production.
# DB_SEARCH_PATH=

# --- Secrets ---------------------------------------------------------------------------------------------------------------

# Signs session cookies. At least 32 random bytes, base64. install.sh generates it. Changing it signs everyone out.
SESSION_SECRET=

# AES-256 key (base64, 32 bytes) that encrypts the tablet and Squarespace credentials stored in the database. install.sh
# generates it. Keep a copy in a password manager: without it those credentials cannot be read. Rotate with
# deploy/scripts/secrets-rotate.sh (docs/runbook.md, "Rotate secrets").
SECRETS_KEY=

# Name of the session cookie. In production over HTTPS the app uses "__Host-" plus this name automatically.
SESSION_COOKIE_NAME=oasis_sid

# HMAC key for filesystem-storage URLs (16+ characters). Only used with STORAGE_PROVIDER=fs; falls back to SESSION_SECRET.
# Not read yet: src/config/env.ts does not declare it, so the process ignores it (docs/deployment.md, "Known gaps").
# STORAGE_SIGNING_SECRET=

# --- Public addresses ------------------------------------------------------------------------------------------------------

# The public HTTPS origin of the API and of the dashboard. They are the same host behind nginx (the dashboard calls /api on its own
# origin). install.sh writes both from --domain. Invite and password-reset links in texts and emails use PUBLIC_DASHBOARD_URL.
PUBLIC_API_URL=https://oasis.example.com
PUBLIC_DASHBOARD_URL=https://oasis.example.com

# --- Jobs ------------------------------------------------------------------------------------------------------------------

# true: the process talks to pg-boss. The API enqueues; only oasis-worker runs the jobs.
JOBS_ENABLED=true

# Emergency and closure texts drop their "reschedule here" sentence until a landing page exists. Leave false for now.
RESCHEDULE_LINK_ENABLED=false

# --- Squarespace (card processor and commerce source; read-only for payments) --------------------------------------------------

# sim or live. Switch to live only after pnpm verify:squarespace passes.
SQSP_PROVIDER=sim

# The API base. Only change it for a simulator.
SQSP_API_BASE=https://api.squarespace.com

# Commerce API key with Orders, Transactions and Contacts set to Read Only. Preferred: store it from Settings (PUT
# /api/v1/integrations/squarespace/connection, encrypted with SECRETS_KEY) and leave this empty.
# SQSP_API_KEY=

# Seconds between sync runs (minimum 30).
SQSP_POLL_INTERVAL_SECONDS=120

# Days with no paid renewal, past the grace period, before a membership is inferred canceled. 0 never infers it.
SQSP_LAPSE_CANCEL_DAYS=60

# User-Agent sent to Squarespace; it rejects requests without one.
# SQSP_USER_AGENT=OasisAutoSpa-Sync/1.0

# Seconds each sync window overlaps the previous one (clock skew, late commits).
# SQSP_OVERLAP_SECONDS=300

# Days the nightly reconcile re-reads.
# SQSP_RECONCILE_DAYS=45

# Requests per minute the client allows itself (Squarespace allows 300).
# SQSP_REQUESTS_PER_MINUTE=240

# Requests per sync run before it saves its place and stops.
# SQSP_MAX_REQUESTS_PER_RUN=120

# true: also process test-mode orders.
# SQSP_INCLUDE_TEST_ORDERS=false

# Days a membership stays active after its paid period ends, before it turns past due.
# SQSP_MEMBERSHIP_GRACE_DAYS=7

# Below this confidence (0.5 to 1) a payment match is not applied by itself and goes to the manual queue.
# SQSP_MATCH_CONFIDENCE_THRESHOLD=0.8

# Cents of difference between Squarespace's total and ours that raise a variance alert.
# SQSP_VARIANCE_ALERT_CENTS=100

# Days a payment link stays matchable, and the cents of tolerance on its amount.
# SQSP_LINK_WINDOW_DAYS=14
# SQSP_LINK_AMOUNT_TOLERANCE_CENTS=1

# Product map as JSON in single quotes, or manage it in Settings (recommended). pnpm verify:squarespace proposes one.
# SQSP_PRODUCT_MAP=

# Hex secret returned once by Squarespace when a webhook subscription is created (webhooks are optional; polling is the baseline).
# SQSP_WEBHOOK_SECRET=

# --- SMS (SMS Gate on a cellular tablet over Tailscale) ---------------------------------------------------------------------

# sim or smsgate. With smsgate, the four SMSGATE_* values below must be set in the environment too (the schema requires
# them), even though the running app reads the tablet's URL and credentials from the database (Settings, SMS devices).
SMS_PROVIDER=sim

# jobs: oasis-worker sends. inline: the API process sends (single-process setups). off: nobody (the queue just fills).
SMS_DISPATCH_MODE=jobs

# Milliseconds between dispatcher ticks while it has work (minimum 250).
# SMS_TICK_INTERVAL_MS=2000

# Local-time window (BUSINESS_TZ) that holds marketing-style texts, or "off". Transactional texts ignore it.
# SMS_QUIET_HOURS=21:00-08:00

# Tablet local server, e.g. http://100.x.y.z:8080 (its Tailscale address). Needed only when SMS_PROVIDER=smsgate.
# SMSGATE_DEVICE_URL=

# Basic-auth user and password shown in the SMS Gate app under Local Server.
# SMSGATE_USERNAME=
# SMSGATE_PASSWORD=

# The signing key set in the SMS Gate app (Settings, Webhooks). gen-secrets.sh can create one to type into the app.
# SMSGATE_WEBHOOK_SECRET=

# The HTTPS address the tablet posts to, from tailscale-serve.sh. Example: https://oasis-api.tailnet-name.ts.net:8443/hooks/smsgate
# SMSGATE_WEBHOOK_PUBLIC_URL=

# Text allow-list (comma separated E.164 numbers). Empty means unrestricted in production; set it for a first live run.
# SMS_ALLOWLIST=

# Android's confirmation prompt appears after about this many texts in the window. Measure with pnpm verify:smsgate first.
# SMSGATE_MAX_PER_WINDOW=30
# SMSGATE_WINDOW_MINUTES=30

# Device API route family: /messages (current) or /message (older builds).
# SMSGATE_API_PATH=/messages

# Milliseconds before a request to the tablet times out (minimum 500).
# SMSGATE_TIMEOUT_MS=10000

# Seconds of clock difference accepted on a webhook (the tablet retries for up to two days).
# SMSGATE_WEBHOOK_TOLERANCE_SECONDS=86400

# Re-sends after an ambiguous failure where the device says it never saw the id (0 to 3).
# SMSGATE_RESEND_ATTEMPTS=1

# Default SIM slot on a dual-SIM tablet (1 to 3).
# SMSGATE_SIM_NUMBER=

# true: send the deprecated "message" field for very old app builds.
# SMSGATE_LEGACY_MESSAGE_FIELD=false

# true: push the signing key to the tablet while registering webhooks.
# SMSGATE_SYNC_SIGNING_KEY=false

# true: accept http:// webhook targets (only the app's insecure build flavour accepts them).
# SMSGATE_ALLOW_INSECURE_WEBHOOK_URL=false

# Segments of each window kept for urgent texts, a safety margin taken off the window, the pause between sends, and the
# longest accepted message in segments.
# SMSGATE_RESERVED_P0=6
# SMSGATE_SAFETY_MARGIN=0
# SMSGATE_MIN_INTERVAL_MS=3000
# SMSGATE_MAX_SEGMENTS=8

# Seconds of silence after which the tablet is marked offline, and after which online becomes degraded.
# SMSGATE_HEARTBEAT_STALE_SECONDS=600
# SMSGATE_ONLINE_WITHIN_SECONDS=180

# --- Email (AWS SES) -------------------------------------------------------------------------------------------------------

# sim writes .eml files and sends nothing; ses sends through Amazon SES. Switch after pnpm verify:aws passes.
EMAIL_PROVIDER=sim

# AWS region of SES and S3. Credentials come from the EC2 instance role (no keys in this file).
AWS_REGION=us-east-1

# Sender on the verified SES identity. Required when EMAIL_PROVIDER=ses.
# SES_FROM_ADDRESS=no-reply@oasis.example.com

# Display name on the From line.
SES_FROM_NAME='Oasis Auto Spa'

# Reply-To address and SES configuration set (bounce and complaint events).
# SES_REPLY_TO=
# SES_CONFIGURATION_SET=

# SNS topics /hooks/ses accepts, comma separated. Not read yet: src/config/env.ts does not declare it and no /hooks/ses route is
# mounted (docs/deployment.md, "Known gaps").
# SES_SNS_TOPIC_ARNS=

# Where the sim driver writes .eml files.
EMAIL_CONSOLE_DIR=/var/lib/oasis/mail

# --- Files (photos and documents) ------------------------------------------------------------------------------------------

# fs keeps files on this host (development); s3 uses the bucket. Production: s3.
STORAGE_PROVIDER=fs

# Directory for STORAGE_PROVIDER=fs.
STORAGE_FS_ROOT=/var/lib/oasis/files

# Bucket for STORAGE_PROVIDER=s3. Give the app's IAM role s3:PutObject, GetObject and DeleteObject on the whole bucket and
# s3:ListBucket (docs/live-verification.md has the policy).
# S3_BUCKET=

# A prefix inside the bucket (prod/), the default encryption header (none, AES256 or aws:kms), the KMS key, and the S3-compatible
# endpoint settings (leave unset for AWS). Not read yet: src/config/env.ts does not declare them, so the process ignores them and
# uses no prefix, no header and the AWS endpoint (docs/deployment.md, "Known gaps"). Do not scope the IAM policy to a prefix until
# they are declared.
# S3_KEY_PREFIX=prod/
# S3_SSE=none
# S3_KMS_KEY_ID=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# --- Never in production ---------------------------------------------------------------------------------------------------

# Test and parity only. The app refuses to start with this set while NODE_ENV=production.
# CLOCK_FREEZE_AT=

# Mounts the /dev endpoints (injected texts, the mail viewer). Keep false.
ALLOW_DEV_ENDPOINTS=false

# Makes every request a signed-in user with every permission. The app refuses to start with this set in production.
# DEV_AUTH_BYPASS=false
