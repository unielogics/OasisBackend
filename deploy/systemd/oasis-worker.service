[Unit]
Description=Oasis Auto Spa worker (pg-boss jobs: SMS dispatch, reminders, Squarespace sync)
Documentation=file:///opt/oasis/current/backend/docs/deployment.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
PartOf=oasis.target
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
Type=simple
User=oasis
Group=oasis
WorkingDirectory=/opt/oasis/current/backend
Environment=NODE_ENV=production
EnvironmentFile=/etc/oasis/common.env
EnvironmentFile=/etc/oasis/worker.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=3
TimeoutStartSec=60
# A job in flight finishes (or is retried by pg-boss) when the worker is stopped.
TimeoutStopSec=45
KillSignal=SIGTERM
SyslogIdentifier=oasis-worker

LimitNOFILE=65536
MemoryMax=1000M
TasksMax=512

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
StateDirectory=oasis
StateDirectoryMode=0750
ReadWritePaths=/var/lib/oasis

[Install]
WantedBy=multi-user.target
