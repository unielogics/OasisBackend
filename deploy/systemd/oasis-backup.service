[Unit]
Description=Oasis Auto Spa nightly database backup (pg_dump, custom format)
Documentation=file:///opt/oasis/current/backend/docs/runbook.md
# The database may be remote (Aurora); install.sh --local-db adds postgresql.service as a drop-in.
After=network-online.target
Wants=network-online.target
OnFailure=oasis-notify-failure@%n.service

[Service]
Type=oneshot
User=oasis
Group=oasis
WorkingDirectory=/opt/oasis/current/backend
Environment=NODE_ENV=production
EnvironmentFile=/etc/oasis/common.env
EnvironmentFile=-/etc/oasis/backup.env
# The root-owned kit (install.sh, refreshed by every deploy); the working directory is the release whose node_modules it borrows.
ExecStart=/usr/local/lib/oasis/deploy/scripts/backup.sh --label nightly
SyslogIdentifier=oasis-backup
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
ReadWritePaths=/var/backups/oasis /var/log/oasis
