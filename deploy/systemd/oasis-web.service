[Unit]
Description=Oasis Auto Spa dashboard (Next.js production server)
Documentation=file:///opt/oasis/current/backend/docs/deployment.md
After=network-online.target oasis-api.service
Wants=network-online.target
PartOf=oasis.target
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
Type=simple
User=oasis
Group=oasis
WorkingDirectory=/opt/oasis/current/dashboard
# The live variant of the dashboard (pnpm build:live) lives in .next-live and talks to /api on its own origin.
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_VARIANT=live
Environment=DIST_DIR=.next-live
Environment=WEB_HOST=127.0.0.1
Environment=WEB_PORT=3200
EnvironmentFile=/etc/oasis/web.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p ${WEB_PORT} -H ${WEB_HOST}
Restart=always
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=20
KillSignal=SIGTERM
SyslogIdentifier=oasis-web

LimitNOFILE=65536
MemoryMax=1200M
TasksMax=512

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Next writes its response cache next to the build.
ReadWritePaths=/opt/oasis/releases

[Install]
WantedBy=multi-user.target
