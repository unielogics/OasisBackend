[Unit]
Description=Oasis Auto Spa health check (API readiness, dashboard)
After=network-online.target

[Service]
Type=oneshot
User=oasis
Group=oasis
Environment=NODE_ENV=production
EnvironmentFile=-/etc/oasis/web.env
EnvironmentFile=-/etc/oasis/api.env
ExecStart=/opt/oasis/current/backend/deploy/scripts/healthcheck.sh --quiet
SyslogIdentifier=oasis-healthcheck
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
