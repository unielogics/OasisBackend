# /etc/logrotate.d/oasis  -  installed by deploy/scripts/install.sh. The services log to journald (journalctl -u oasis-api); these are the files.
# nginx's own logs (/var/log/nginx/*.log, the dashboard's and the website's included) are rotated by the nginx package's
# /etc/logrotate.d/nginx. Naming them here again makes every logrotate run fail ("duplicate log entry ... found error in file oasis,
# skipping", exit 1), so this file does not.

/var/log/oasis/*.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
